{
  "info": {
    "name": "MERN Backend - Auth, Browse Listings, My Claims",
    "description": "Demo collection for the backend starter. Start the API and run the seed script first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "listingId", "value": "" },
    { "key": "claimId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/health" }
    },
    {
      "name": "2. Register Test User",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test.user@example.com\",\n  \"password\": \"TestPass123!\"\n}" },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Account created or duplicate handled', function () {", "  pm.expect([201, 409]).to.include(pm.response.code);", "});"] } }]
    },
    {
      "name": "3. Login Test User (saves token)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"test.user@example.com\",\n  \"password\": \"TestPass123!\"\n}" },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Login succeeded', function () { pm.response.to.have.status(200); });", "const json = pm.response.json();", "if (json.success && json.data && json.data.token) pm.collectionVariables.set('token', json.data.token);"] } }]
    },
    {
      "name": "4. Browse Listings (saves first listingId)",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/listings?page=1&limit=10" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Browse request succeeded', function () { pm.response.to.have.status(200); });", "const json = pm.response.json();", "if (json.success && json.data.items && json.data.items.length) pm.collectionVariables.set('listingId', json.data.items[0]._id);"] } }]
    },
    {
      "name": "5. Submit Claim (saves claimId)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "body": { "mode": "raw", "raw": "{\n  \"listingId\": \"{{listingId}}\",\n  \"message\": \"I am interested in this listing.\"\n}" },
        "url": "{{baseUrl}}/api/claims"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Claim submitted or already claimed', function () { pm.expect([201, 409]).to.include(pm.response.code); });", "const json = pm.response.json();", "if (json.success && json.data.claim) pm.collectionVariables.set('claimId', json.data.claim._id);"] } }]
    },
    {
      "name": "6. My Claims",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": "{{baseUrl}}/api/claims/my"
      }
    },
    {
      "name": "7. Cancel Pending Claim",
      "request": {
        "method": "PATCH",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": "{{baseUrl}}/api/claims/{{claimId}}/cancel"
      }
    },
    {
      "name": "8. Current User (/me)",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": "{{baseUrl}}/api/auth/me"
      }
    }
  ]
}
