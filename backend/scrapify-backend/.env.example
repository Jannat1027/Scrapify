PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/scrapify
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Address(es) of the frontend, comma separated. Add the deployed frontend URL here too.
CLIENT_URL=http://localhost:5173

# Used only by `npm run create-admin` (makes the first admin account, or resets its password).
ADMIN_NAME=Scrapify Admin
ADMIN_EMAIL=admin@scrapify.app
ADMIN_PASSWORD=change-me-too

# Required to create manual payment records for these methods.
BKASH_MERCHANT_NUMBER=
NAGAD_MERCHANT_NUMBER=
