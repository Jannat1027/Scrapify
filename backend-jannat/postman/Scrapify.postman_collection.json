{
  "info": {
    "name": "Scrapify API",
    "description": "Every Scrapify endpoint. Run `npm run seed` first, then run the four requests in \"0. Log in\" — they save a token for each role into collection variables, which the other folders use.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "operatorToken",
      "value": ""
    },
    {
      "key": "recyclerToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "scanId",
      "value": "SC-1042"
    },
    {
      "key": "listingId",
      "value": "LS-2209"
    }
  ],
  "item": [
    {
      "name": "0. Log in (run first)",
      "item": [
        {
          "name": "Login as operator",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rahima@greenbin.bd\",\n  \"password\": \"demo1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Logged in\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"operatorToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as recycler",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tanvir@polymerloop.com\",\n  \"password\": \"demo1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Logged in\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"recyclerToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [],
