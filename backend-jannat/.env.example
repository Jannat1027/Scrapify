PORT=5050
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/scrapify
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Address(es) of the frontend, comma separated. Add the deployed frontend URL here too.
CLIENT_URL=http://localhost:5173

# Used only by `npm run create-admin` (makes the first admin account, or resets its password).
ADMIN_NAME=Scrapify Admin
ADMIN_EMAIL=admin@scrapify.app
ADMIN_PASSWORD=change-me-too

# Online payments through SSLCommerz (bKash, Nagad, Rocket, cards).
# testbox / qwerty is SSLCommerz's public sandbox store: test payments only, no real money.
# For real payments use your own store from https://sslcommerz.com and set SSLCOMMERZ_LIVE=true.
# Leave SSLCOMMERZ_STORE_ID empty to offer manual bKash/Nagad payments only.
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_LIVE=false

# Public address of this API (SSLCommerz sends payment results here). Empty = http://localhost:PORT, or Render's own address on Render.
SERVER_URL=
# Where the recycler returns after paying online when the app they paid from is unknown. Defaults to the first CLIENT_URL.
FRONTEND_URL=
