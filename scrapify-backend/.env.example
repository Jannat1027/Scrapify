# Copy this file to .env and fill in your own values.
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/scrapify
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# The frontend address. Several can be given, separated by commas.
CLIENT_URL=http://localhost:5173
