# Copy this file as ".env" and fill in your own values.
# MongoDB Atlas: Atlas dashboard -> Connect -> Drivers -> copy the connection string.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/scrapify

# Any long random text. Used to sign login tokens.
JWT_SECRET=change_this_to_a_long_random_secret

# Port the API runs on.
PORT=5000
